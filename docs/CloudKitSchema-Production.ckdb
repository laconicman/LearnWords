DEFINE SCHEMA

    RECORD TYPE CDMR (
        CD_entityNames   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_recordNames   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_relationships STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Comment (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_term                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ErrorTag (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Illustration (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_term                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_urlString           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_urlString_ckAsset   ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Language (
        CD_code                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_code_ckAsset        ASSET,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ReviewEvent (
        CD_answerLanguage         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_answerLanguage_ckAsset ASSET,
        CD_date                   TIMESTAMP QUERYABLE SORTABLE,
        CD_direction              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_direction_ckAsset      ASSET,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expected               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expected_ckAsset       ASSET,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_judgeID                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_judgeID_ckAsset        ASSET,
        CD_judgedAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_judgmentVerdict        DOUBLE QUERYABLE SORTABLE,
        CD_kind                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kind_ckAsset           ASSET,
        CD_latencyMS              INT64 QUERYABLE SORTABLE,
        CD_moveReceipt            BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset    ASSET,
        CD_outcome                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_outcome_ckAsset        ASSET,
        CD_prompt                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_promptLanguage         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_promptLanguage_ckAsset ASSET,
        CD_promptTermID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_prompt_ckAsset         ASSET,
        CD_response               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_response_ckAsset       ASSET,
        CD_schemaVersion          INT64 QUERYABLE SORTABLE,
        CD_sessionID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_synset                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_task                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_task_ckAsset           ASSET,
        CD_wordSetID              STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Synset (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_note                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Tag (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Term (
        CD_createdAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_language              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modifiedAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt           BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset   ASSET,
        CD_partOfSpeech          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_partOfSpeech_ckAsset  ASSET,
        CD_text                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset          ASSET,
        CD_transcription         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transcription_ckAsset ASSET,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WordForm (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_formType            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_formType_ckAsset    ASSET,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_term                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WordSet (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modifiedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
